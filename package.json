{
  "name": "@rozsival/panther-minor-controller",
  "version": "1.0.11",
  "private": true,
  "description": "Remote power control for Panther Minor AI workstation",
  "repository": {
    "type": "git",
    "url": "https://github.com/rozsival/panther-minor-controller.git"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "cargo:build": "cargo build --workspace",
    "cargo:check": "cargo check --workspace",
    "cargo:clippy": "cargo clippy --workspace -- -D warnings",
    "cargo:fmt": "cargo fmt",
    "cargo:run": "cargo watch -x run",
    "cargo:test": "cargo test --workspace",
    "check:sh": "shellcheck scripts/*.sh",
    "postinstall": "is-ci || lefthook install",
    "prettier:write": "prettier --check --write ."
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "24.19.2",
    "is-ci": "4.1.0",
    "lefthook": "2.2.1",
    "prettier": "3.9.9",
    "prettier-plugin-packagejson": "3.0.2",
    "prettier-plugin-sh": "0.20.2",
    "prettier-plugin-toml": "3.0.2",
    "shellcheck": "4.1.0",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.11.1",
  "engines": {
    "node": "24.x"
  }
}
